{
  "name": "as-radar-x",
  "main": "electron/main.cjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "desktop:icon": "node scripts/generate-icon.cjs",
    "desktop:dist": "npm run build && npm run desktop:icon && electron-builder --win nsis --x64",
    "desktop:dir": "npm run build && npm run desktop:icon && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "archiver": "^8.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "tsx": "^4.21.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12",
    "@types/archiver": "^8.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "com.saradagreats.asradarx",
    "productName": "AS-Radar-X",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "server.ts",
      "electron/main.cjs",
      "package.json",
      "!src/**/*",
      "!scripts/**/*",
      "!desktop-resources/**/*",
      "!**/*.map",
      "!**/README.md",
      "!**/*.test.*",
      "!**/__tests__/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "license": "installer/LICENSE.txt"
    }
  }
}
